#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <30>;
    delay-ms = <0>;
};

/ {
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <64>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    hold_tap_fast: hold_tap_fast {
        compatible = "zmk,behavior-hold-tap";
        label = "HOLD_TAP_FAST";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <80>;
    };

    behaviors {
    };

    macros {
        clean_caret: clean_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp SPACE>;
            label = "CLEAN_CARET";
        };

        clean_grave: clean_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp SPACE>;
            label = "CLEAN_GRAVE";
        };

        clean_apostrophe: clean_apostrophe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp APOSTROPHE &kp SPACE>;
            label = "CLEAN_APOSTROPHE";
        };

        clean_dqt: clean_dqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp SPACE>;
            label = "CLEAN_DQT";
        };

        // Capa 1 momentánea sin retardo (wait-ms y tap-ms en 0)
        mo_layer_1: mo_layer_1 {
            compatible = "zmk,behavior-macro";
            label = "MO_LAYER_1";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(120,100,50)>
                , <&macro_pause_for_release>
                , <&macro_release &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(180,60,40)>;
        };

        // Capa 2 momentánea sin retardo (wait-ms y tap-ms en 0)
        mo_layer_2: mo_layer_2 {
            compatible = "zmk,behavior-macro";
            label = "MO_LAYER_2";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,50)>
                , <&macro_pause_for_release>
                , <&macro_release &mo 2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(180,60,40)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4       &kp N5       &kp N6     &kp N7     &kp N8     &kp N9   &kp N0     &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E         &kp R        &kp T        &kp Y      &kp U      &kp I      &kp O    &kp P      &kp SQT
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F        &kp G        &kp H      &kp J      &kp K      &kp L    &kp RA(N)  &kp SEMI
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V        &kp B        &kp N      &kp M      &kp COMMA  &kp DOT  &kp MINUS  &kp SLASH
                                &kp LEFT_ALT  &mo_layer_2  &mkp LCLK    &kp ENTER  &kp SPACE
                                              &mo_layer_1  &mkp RCLK    &kp LGUI
            >;

            sensor-bindings = <&scroll_vertical_encoder>;
        };

        layer_1 {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5           &kp F6                            &kp F7     &kp F8     &kp F9     &kp F10      &kp F11
&trans   &trans  &trans  &trans  &trans  &kp KP_NUM       &kp KP_MULTIPLY                   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS  &kp PG_UP
&trans   &trans  &trans  &trans  &trans  &trans           &kp KP_DIVIDE                     &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS &kp PAGE_DOWN
&trans   &trans  &trans  &trans  &trans  &rgb_ug RGB_TOG  &kp CARET                         &kp KP_N1  &kp KP_N2  &kp KP_N3  &none        &kp RA(SLASH)
                         &trans  &trans  &trans           &hold_tap_fast C_VOL_UP C_NEXT    &kp KP_N0
                                 &trans  &trans           &hold_tap_fast C_VOLUME_DOWN C_PREVIOUS
            >;

            sensor-bindings = <&scroll_vertical_encoder>;
        };

        layer_2 {
            bindings = <
&trans    &kp RA(N1)    &kp LS(RA(SEMI))   &clean_caret  &trans    &trans     &trans  &trans     &trans        &trans     &trans                &kp DEL
&kp STAR  &kp AT        &kp COLON          &kp AMPS      &kp PIPE  &kp DOLLAR &trans  &kp HOME   &kp UP_ARROW  &kp END    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans    &clean_grave  &clean_apostrophe  &clean_dqt    &kp EQUAL &kp BSLH   &trans  &kp LEFT   &kp DOWN      &kp RIGHT  &kp LBKT              &kp RBKT
&trans    &kp LT        &kp GT             &kp RA(N1)    &kp EXCL  &kp SLASH  &trans  &kp UNDER  &kp MINUS     &trans     &kp LBRC              &kp RBRC
                                           &trans        &trans    &trans     &trans  &trans
                                                         &trans    &trans     &trans
            >;

            sensor-bindings = <&scroll_vertical_encoder>;
        };
    };
};
